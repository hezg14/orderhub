// OrderHub — Prisma schema
// Mirrors Architecture.md §3.2 DDL. Prisma enums replace TEXT + CHECK so that
// invalid states are rejected by the database as well as by TypeScript.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  staff
}

enum OrderStatus {
  pending
  paid
  shipped
  completed
  cancelled
}

enum AuditAction {
  create
  update
  delete
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  nameEn       String?    @map("name_en")
  role         Role       @default(staff)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  orders       Order[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  // English display names. Null for records never localized; the API falls
  // back to `name` so the client can always pick by locale without a lookup.
  nameEn    String?  @map("name_en")
  company   String?
  companyEn String?  @map("company_en")
  email     String?
  phone     String?
  address   String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders    Order[]

  @@index([name])
  @@map("customers")
}

model Product {
  id        String      @id @default(uuid()) @db.Uuid
  sku       String      @unique
  name      String
  nameEn    String?     @map("name_en")
  category  String
  unitPrice Decimal     @map("unit_price") @db.Decimal(12, 2)
  stock     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  items     OrderItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  orderNo    String      @unique @map("order_no")
  customerId String      @map("customer_id") @db.Uuid
  status     OrderStatus @default(pending)
  subtotal   Decimal     @db.Decimal(12, 2)
  discount   Decimal     @default(0) @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  note       String?
  createdBy  String      @map("created_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator   User        @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  items     OrderItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt(sort: Desc)])
  @@index([total])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  action    AuditAction
  entity    String
  entityId  String      @map("entity_id")
  detail    Json        @default("{}")
  requestId String?     @map("request_id")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
