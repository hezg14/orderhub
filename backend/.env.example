# --- server ---
NODE_ENV=development
PORT=3000
# comma separated list; Vercel preview domains can be added here
CORS_ORIGIN=http://localhost:5173

# --- database ---
DATABASE_URL=postgresql://orderhub:orderhub@localhost:5432/orderhub?schema=public

# --- auth ---
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-48-byte-random-hex-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# --- seed passwords (demo only) ---
SEED_ADMIN_PASSWORD=Demo1234
SEED_STAFF_PASSWORD=Demo1234

# --- logging ---
LOG_LEVEL=info
